# copy this file to .env.local and change if your setup differs
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=movie_ticket_booking

# the three MySQL accounts created by sql/06_roles.sql
DB_ADMIN_USER=cine_admin
DB_ADMIN_PASS=Admin@123
DB_THEATRE_USER=cine_theatre
DB_THEATRE_PASS=Theatre@123
DB_CUSTOMER_USER=cine_customer
DB_CUSTOMER_PASS=Customer@123

REDIS_URL=redis://127.0.0.1:6379

# any long random string
JWT_SECRET=change-this-to-a-long-random-string-1234567890
